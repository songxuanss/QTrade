# Copy to .env for local deployment. Never commit real credentials.
# Local database/cache/object-store credentials have development-only defaults in compose.yaml.

# MaiRui data provider (leave empty until a valid licence is configured)
MAIRUI_LICENCE=
QTRADE_MAIRUI_PRO_ENABLED=false
QTRADE_TICK_DOWNLOAD_MAX_DAYS=0
QTRADE_COLLECTION_MIN_INTERVAL_SECONDS=3

# Optional independent collector connection
QTRADE_COLLECTOR_COMPOSE_URL=
COLLECTOR_SERVICE_TOKEN=
COLLECTOR_FRESHNESS_CONSUMER_ID=qtrade-alerts
QTRADE_COLLECTOR_ALLOW_HTTP=false
# DATA_COLLECTION_DATABASE_URL=

# Public web/API origins
QTRADE_PUBLIC_ORIGIN=http://localhost:13000
QTRADE_API_ORIGIN=http://api:8000
QTRADE_API_PUBLIC_ORIGIN=http://localhost:18000

# OIDC/BFF; use the sibling SSO project's values and generated secrets
QTRADE_OIDC_ISSUER=
QTRADE_OIDC_CLIENT_ID=
QTRADE_OIDC_CLIENT_SECRET=
QTRADE_OIDC_TRANSACTION_KEY=
QTRADE_BFF_SECRET=
QTRADE_OIDC_ALLOW_HTTP=false
QTRADE_INSECURE_LOCAL_COOKIES=false

# Optional alert delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_SENDER=
SMTP_USERNAME=
SMTP_PASSWORD=
QTRADE_WEBHOOK_ALLOWED_HOSTS=
QTRADE_WEBHOOK_DESTINATIONS=

# Build metadata
QTRADE_BUILD_REVISION=unknown
