FROM python:3.12-slim
ARG QTRADE_BUILD_REVISION=unknown
LABEL org.opencontainers.image.revision=$QTRADE_BUILD_REVISION
WORKDIR /app
COPY pyproject.toml uv.lock ./
COPY --from=ghcr.io/astral-sh/uv:0.12.22 /uv /usr/local/bin/uv
RUN uv sync --locked --no-dev
COPY apps/ ./apps/
COPY packages/ ./packages/
COPY adapters/ ./adapters/
ENV PATH="/app/.venv/bin:$PATH" PYTHONPATH="/app/apps/api/src:/app/apps/worker/src:/app/apps/realtime/src:/app/apps/common/src:/app/packages/domain/src:/app/packages/contracts/src:/app/packages/data-contracts/src:/app/packages/data-core/src:/app/adapters/data_mairui/src:/app/adapters/data_postgres/src:/app/adapters/data_http/src:/app/adapters/mock/src:/app/adapters/runner/src:/app/adapters/object_store/src:/app/adapters/postgres/src:/app/adapters/crypto/src:/app/adapters/parquet/src:/app/adapters/mairui/src:/app/adapters/notifications/src:/app/packages/runtime/src:/app/packages/application/src" PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
RUN useradd --uid 10001 --create-home qtrade
USER qtrade
EXPOSE 8000
CMD ["uvicorn", "qtrade_api.main:app", "--host", "0.0.0.0", "--port", "8000"]
