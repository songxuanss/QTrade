{
  "$defs": {
    "OrderIntent": {
      "additionalProperties": false,
      "properties": {
        "account_id": {
          "format": "uuid",
          "title": "Account Id",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "created_by": {
          "format": "uuid",
          "title": "Created By",
          "type": "string"
        },
        "instrument_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Instrument Id",
          "type": "string"
        },
        "intent_id": {
          "format": "uuid",
          "title": "Intent Id",
          "type": "string"
        },
        "limit_price": {
          "anyOf": [
            {
              "pattern": "^(?:0\\.0*[1-9][0-9]*|[1-9][0-9]*(?:\\.[0-9]+)?)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Limit Price"
        },
        "order_type": {
          "enum": [
            "market",
            "limit",
            "stop",
            "stop_limit"
          ],
          "title": "Order Type",
          "type": "string"
        },
        "quantity": {
          "pattern": "^(?:0\\.0*[1-9][0-9]*|[1-9][0-9]*(?:\\.[0-9]+)?)$",
          "title": "Quantity",
          "type": "string"
        },
        "runtime_id": {
          "format": "uuid",
          "title": "Runtime Id",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "side": {
          "enum": [
            "buy",
            "sell"
          ],
          "title": "Side",
          "type": "string"
        },
        "stop_price": {
          "anyOf": [
            {
              "pattern": "^(?:0\\.0*[1-9][0-9]*|[1-9][0-9]*(?:\\.[0-9]+)?)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stop Price"
        },
        "strategy_version_id": {
          "format": "uuid",
          "title": "Strategy Version Id",
          "type": "string"
        },
        "time_in_force": {
          "enum": [
            "day",
            "gtc",
            "ioc",
            "fok"
          ],
          "title": "Time In Force",
          "type": "string"
        },
        "trace_id": {
          "format": "uuid",
          "title": "Trace Id",
          "type": "string"
        },
        "workspace_id": {
          "format": "uuid",
          "title": "Workspace Id",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "workspace_id",
        "intent_id",
        "account_id",
        "runtime_id",
        "strategy_version_id",
        "created_by",
        "created_at",
        "instrument_id",
        "side",
        "order_type",
        "quantity",
        "time_in_force",
        "trace_id"
      ],
      "title": "OrderIntent",
      "type": "object"
    },
    "RiskDecision": {
      "additionalProperties": false,
      "properties": {
        "decided_at": {
          "format": "date-time",
          "title": "Decided At",
          "type": "string"
        },
        "decision_id": {
          "format": "uuid",
          "title": "Decision Id",
          "type": "string"
        },
        "input_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Sha256",
          "type": "string"
        },
        "intent_id": {
          "format": "uuid",
          "title": "Intent Id",
          "type": "string"
        },
        "outcome": {
          "enum": [
            "allow",
            "deny",
            "require_approval"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "reasons": {
          "items": {
            "$ref": "#/$defs/RiskReason"
          },
          "title": "Reasons",
          "type": "array"
        },
        "rule_set_version": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Rule Set Version",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "trace_id": {
          "format": "uuid",
          "title": "Trace Id",
          "type": "string"
        },
        "workspace_id": {
          "format": "uuid",
          "title": "Workspace Id",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "workspace_id",
        "decision_id",
        "intent_id",
        "decided_at",
        "outcome",
        "rule_set_version",
        "input_sha256",
        "reasons",
        "trace_id"
      ],
      "title": "RiskDecision",
      "type": "object"
    },
    "RiskReason": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "current_value": {
          "anyOf": [
            {
              "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Current Value"
        },
        "limit_value": {
          "anyOf": [
            {
              "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Limit Value"
        },
        "rule_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Rule Id",
          "type": "string"
        },
        "rule_version": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Rule Version",
          "type": "string"
        },
        "summary": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "rule_id",
        "rule_version",
        "code",
        "summary"
      ],
      "title": "RiskReason",
      "type": "object"
    }
  },
  "$id": "urn:qtrade:contracts:v1:OrderCommand",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authorized_at": {
      "format": "date-time",
      "title": "Authorized At",
      "type": "string"
    },
    "command_id": {
      "format": "uuid",
      "title": "Command Id",
      "type": "string"
    },
    "decision": {
      "$ref": "#/$defs/RiskDecision"
    },
    "idempotency_key": {
      "format": "uuid",
      "title": "Idempotency Key",
      "type": "string"
    },
    "intent": {
      "$ref": "#/$defs/OrderIntent"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "workspace_id": {
      "format": "uuid",
      "title": "Workspace Id",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "workspace_id",
    "command_id",
    "idempotency_key",
    "intent",
    "decision",
    "authorized_at"
  ],
  "title": "OrderCommand",
  "type": "object"
}
