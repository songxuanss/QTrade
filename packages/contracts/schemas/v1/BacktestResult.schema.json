{
  "$defs": {
    "BacktestDeterminism": {
      "additionalProperties": false,
      "properties": {
        "engine": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Engine",
          "type": "string"
        },
        "seed": {
          "minimum": 0,
          "title": "Seed",
          "type": "integer"
        }
      },
      "required": [
        "engine",
        "seed"
      ],
      "title": "BacktestDeterminism",
      "type": "object"
    },
    "BacktestEquityPoint": {
      "additionalProperties": false,
      "properties": {
        "benchmark_equity": {
          "anyOf": [
            {
              "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Benchmark Equity"
        },
        "cash": {
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "title": "Cash",
          "type": "string"
        },
        "drawdown": {
          "default": "0",
          "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
          "title": "Drawdown",
          "type": "string"
        },
        "equity": {
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "title": "Equity",
          "type": "string"
        },
        "positions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/BacktestPosition"
          },
          "title": "Positions",
          "type": "array"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        }
      },
      "required": [
        "timestamp",
        "cash",
        "equity"
      ],
      "title": "BacktestEquityPoint",
      "type": "object"
    },
    "BacktestFill": {
      "additionalProperties": false,
      "properties": {
        "fee": {
          "default": "0",
          "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
          "title": "Fee",
          "type": "string"
        },
        "filled_at": {
          "format": "date-time",
          "title": "Filled At",
          "type": "string"
        },
        "filled_quantity": {
          "pattern": "^(?:0\\.0*[1-9][0-9]*|[1-9][0-9]*(?:\\.[0-9]+)?)$",
          "title": "Filled Quantity",
          "type": "string"
        },
        "instrument_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Instrument Id",
          "type": "string"
        },
        "price": {
          "pattern": "^(?:0\\.0*[1-9][0-9]*|[1-9][0-9]*(?:\\.[0-9]+)?)$",
          "title": "Price",
          "type": "string"
        },
        "side": {
          "enum": [
            "buy",
            "sell"
          ],
          "title": "Side",
          "type": "string"
        }
      },
      "required": [
        "instrument_id",
        "side",
        "filled_quantity",
        "filled_at",
        "price"
      ],
      "title": "BacktestFill",
      "type": "object"
    },
    "BacktestMetrics": {
      "additionalProperties": false,
      "properties": {
        "annualized_return": {
          "anyOf": [
            {
              "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Annualized Return"
        },
        "annualized_volatility": {
          "anyOf": [
            {
              "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Annualized Volatility"
        },
        "average_exposure": {
          "default": "0",
          "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
          "title": "Average Exposure",
          "type": "string"
        },
        "benchmark_return": {
          "anyOf": [
            {
              "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Benchmark Return"
        },
        "calmar_ratio": {
          "anyOf": [
            {
              "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Calmar Ratio"
        },
        "losing_trades": {
          "default": 0,
          "minimum": 0,
          "title": "Losing Trades",
          "type": "integer"
        },
        "max_drawdown": {
          "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
          "title": "Max Drawdown",
          "type": "string"
        },
        "max_exposure": {
          "default": "0",
          "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
          "title": "Max Exposure",
          "type": "string"
        },
        "profit_factor": {
          "anyOf": [
            {
              "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Profit Factor"
        },
        "sharpe_ratio": {
          "anyOf": [
            {
              "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sharpe Ratio"
        },
        "sortino_ratio": {
          "anyOf": [
            {
              "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sortino Ratio"
        },
        "trade_count": {
          "default": 0,
          "minimum": 0,
          "title": "Trade Count",
          "type": "integer"
        },
        "turnover": {
          "default": "0",
          "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
          "title": "Turnover",
          "type": "string"
        },
        "win_rate": {
          "anyOf": [
            {
              "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Win Rate"
        },
        "winning_trades": {
          "default": 0,
          "minimum": 0,
          "title": "Winning Trades",
          "type": "integer"
        }
      },
      "required": [
        "max_drawdown"
      ],
      "title": "BacktestMetrics",
      "type": "object"
    },
    "BacktestOrder": {
      "additionalProperties": false,
      "properties": {
        "filled_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Filled At"
        },
        "filled_quantity": {
          "anyOf": [
            {
              "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Filled Quantity"
        },
        "instrument_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Instrument Id",
          "type": "string"
        },
        "price": {
          "anyOf": [
            {
              "pattern": "^(?:0\\.0*[1-9][0-9]*|[1-9][0-9]*(?:\\.[0-9]+)?)$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Price"
        },
        "quantity": {
          "pattern": "^(?:0\\.0*[1-9][0-9]*|[1-9][0-9]*(?:\\.[0-9]+)?)$",
          "title": "Quantity",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "enum": [
                "signal",
                "membership_end",
                "rights_subscription",
                "halted",
                "limit_up",
                "limit_down",
                "locked"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "side": {
          "enum": [
            "buy",
            "sell"
          ],
          "title": "Side",
          "type": "string"
        },
        "status": {
          "enum": [
            "filled",
            "rejected",
            "cancelled",
            "partially_filled_end_of_data",
            "unfilled_end_of_data"
          ],
          "title": "Status",
          "type": "string"
        },
        "submitted_at": {
          "format": "date-time",
          "title": "Submitted At",
          "type": "string"
        }
      },
      "required": [
        "instrument_id",
        "side",
        "quantity",
        "submitted_at",
        "status"
      ],
      "title": "BacktestOrder",
      "type": "object"
    },
    "BacktestPosition": {
      "additionalProperties": false,
      "properties": {
        "instrument_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Instrument Id",
          "type": "string"
        },
        "market_value": {
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "title": "Market Value",
          "type": "string"
        },
        "quantity": {
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "title": "Quantity",
          "type": "string"
        }
      },
      "required": [
        "instrument_id",
        "quantity",
        "market_value"
      ],
      "title": "BacktestPosition",
      "type": "object"
    },
    "BacktestSummary": {
      "additionalProperties": false,
      "properties": {
        "ending_drawdown": {
          "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
          "title": "Ending Drawdown",
          "type": "string"
        },
        "final_equity": {
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "title": "Final Equity",
          "type": "string"
        },
        "initial_cash": {
          "pattern": "^(?:0\\.0*[1-9][0-9]*|[1-9][0-9]*(?:\\.[0-9]+)?)$",
          "title": "Initial Cash",
          "type": "string"
        },
        "sample_count": {
          "minimum": 1,
          "title": "Sample Count",
          "type": "integer"
        },
        "total_return": {
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "title": "Total Return",
          "type": "string"
        }
      },
      "required": [
        "initial_cash",
        "final_equity",
        "total_return",
        "ending_drawdown",
        "sample_count"
      ],
      "title": "BacktestSummary",
      "type": "object"
    }
  },
  "$id": "urn:qtrade:contracts:v1:BacktestResult",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "currency": {
      "pattern": "^[A-Z]{3,10}$",
      "title": "Currency",
      "type": "string"
    },
    "dataset_id": {
      "format": "uuid",
      "title": "Dataset Id",
      "type": "string"
    },
    "determinism": {
      "$ref": "#/$defs/BacktestDeterminism"
    },
    "equity_curve": {
      "items": {
        "$ref": "#/$defs/BacktestEquityPoint"
      },
      "minItems": 1,
      "title": "Equity Curve",
      "type": "array"
    },
    "fills": {
      "items": {
        "$ref": "#/$defs/BacktestFill"
      },
      "title": "Fills",
      "type": "array"
    },
    "metrics": {
      "anyOf": [
        {
          "$ref": "#/$defs/BacktestMetrics"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "orders": {
      "items": {
        "$ref": "#/$defs/BacktestOrder"
      },
      "title": "Orders",
      "type": "array"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "strategy_version_id": {
      "format": "uuid",
      "title": "Strategy Version Id",
      "type": "string"
    },
    "summary": {
      "$ref": "#/$defs/BacktestSummary"
    },
    "workspace_id": {
      "format": "uuid",
      "title": "Workspace Id",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "workspace_id",
    "dataset_id",
    "strategy_version_id",
    "currency",
    "determinism",
    "equity_curve",
    "orders",
    "fills",
    "summary"
  ],
  "title": "BacktestResult",
  "type": "object"
}
