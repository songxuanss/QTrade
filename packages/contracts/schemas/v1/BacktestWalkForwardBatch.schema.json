      "type": "string"
    },
    "instrument_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Instrument Id",
      "type": "string"
    },
    "parameter_grid_json": {
      "anyOf": [
        {
          "maxLength": 1000000,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parameter Grid Json"
    },
    "parameters_json": {
      "maxLength": 1000000,
      "minLength": 1,
      "title": "Parameters Json",
      "type": "string"
    },
    "random_seed": {
      "minimum": 0,
      "title": "Random Seed",
      "type": "integer"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "start": {
      "format": "date-time",
      "title": "Start",
      "type": "string"
    },
    "step_seconds": {
      "exclusiveMinimum": 0,
      "title": "Step Seconds",
      "type": "integer"
    },
    "strategy_id": {
      "format": "uuid",
      "title": "Strategy Id",
      "type": "string"
    },
    "strategy_version": {
      "minimum": 1,
      "title": "Strategy Version",
      "type": "integer"
    },
    "strategy_version_id": {
      "format": "uuid",
      "title": "Strategy Version Id",
      "type": "string"
    },
    "train_window_seconds": {
