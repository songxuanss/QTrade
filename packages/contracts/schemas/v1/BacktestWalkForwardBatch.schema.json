          "type": "integer"
        },
        "run_id": {
          "format": "uuid",
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "train_end": {
          "format": "date-time",
          "title": "Train End",
          "type": "string"
        },
        "train_samples": {
          "minimum": 1,
          "title": "Train Samples",
          "type": "integer"
        },
        "train_start": {
          "format": "date-time",
          "title": "Train Start",
          "type": "string"
        },
        "validation_end": {
          "format": "date-time",
          "title": "Validation End",
          "type": "string"
        },
        "validation_samples": {
          "minimum": 1,
          "title": "Validation Samples",
          "type": "integer"
        },
        "validation_start": {
          "format": "date-time",
          "title": "Validation Start",
          "type": "string"
        },
        "workspace_id": {
          "format": "uuid",
          "title": "Workspace Id",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "workspace_id",
        "index",
        "train_start",
        "train_end",
        "validation_start",
        "validation_end",
        "train_samples",
        "validation_samples",
        "run_id"
      ],
      "title": "BacktestWalkForwardWindowPlan",
      "type": "object"
    }
