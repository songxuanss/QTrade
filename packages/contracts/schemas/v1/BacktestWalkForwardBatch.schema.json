          "maxLength": 1000000,
          "minLength": 1,
          "title": "Parameters Json",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "train_run_id": {
          "format": "uuid",
          "title": "Train Run Id",
          "type": "string"
        },
        "validation_run_id": {
          "format": "uuid",
          "title": "Validation Run Id",
          "type": "string"
        },
        "workspace_id": {
          "format": "uuid",
          "title": "Workspace Id",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "workspace_id",
        "parameters_json",
        "train_run_id",
        "validation_run_id"
