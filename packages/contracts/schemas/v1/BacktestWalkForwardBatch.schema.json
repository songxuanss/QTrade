  "$id": "urn:qtrade:contracts:v1:BacktestWalkForwardBatch",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "benchmark_id": {
      "anyOf": [
        {
          "maxLength": 256,
          "minLength": 1,
