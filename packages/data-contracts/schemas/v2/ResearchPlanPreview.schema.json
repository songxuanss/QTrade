{
  "$defs": {
    "CollectionCostEstimate": {
      "additionalProperties": false,
      "description": "Uncached execution upper bound before retries, expressed in internal credit.\n\nPreview-time metadata is excluded; zero is a legitimate lower bound when\nevery needed source response is cached or every partition can be reused.",
      "properties": {
        "accounting": {
          "const": "internal_credit_safeguard",
          "title": "Accounting",
          "type": "string"
        },
        "basis": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Basis",
          "type": "string"
        },
        "calls_max": {
          "minimum": 0,
          "title": "Calls Max",
          "type": "integer"
        },
        "calls_min": {
          "minimum": 0,
          "title": "Calls Min",
          "type": "integer"
        },
        "credits_max": {
          "minimum": 0,
          "title": "Credits Max",
          "type": "integer"
        },
        "credits_min": {
          "minimum": 0,
          "title": "Credits Min",
          "type": "integer"
        },
        "includes_retries": {
          "const": false,
          "title": "Includes Retries",
          "type": "boolean"
        }
      },
      "required": [
        "calls_min",
        "calls_max",
        "credits_min",
        "credits_max",
        "accounting",
        "basis",
        "includes_retries"
      ],
      "title": "CollectionCostEstimate",
      "type": "object"
    },
    "CollectionPlanGuard": {
      "additionalProperties": false,
      "description": "Operator limits for new plans, independent of provider history boundaries.\n\nConfirmation thresholds prompt acknowledgement; positive hard limits reject\nthe entire request. Neither changes previously frozen jobs or publications.",
      "properties": {
        "confirm_credits": {
          "maximum": 1000000000,
          "minimum": 1,
          "title": "Confirm Credits",
          "type": "integer"
        },
        "confirm_new_parts": {
          "maximum": 1000000,
          "minimum": 1,
          "title": "Confirm New Parts",
          "type": "integer"
        },
        "max_instruments": {
          "maximum": 10000,
          "minimum": 1,
          "title": "Max Instruments",
          "type": "integer"
        },
        "max_new_parts": {
          "maximum": 1000000,
          "minimum": 1,
          "title": "Max New Parts",
          "type": "integer"
        },
        "version": {
          "const": "collection-plan-guard.v1",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "version",
        "max_instruments",
        "max_new_parts",
        "confirm_new_parts",
        "confirm_credits"
      ],
      "title": "CollectionPlanGuard",
      "type": "object"
    },
    "ResearchCapability": {
      "additionalProperties": false,
      "properties": {
        "configured": {
          "title": "Configured",
          "type": "boolean"
        },
        "date_axes": {
          "items": {
            "enum": [
              "report_period",
              "observation_date",
              "effective_date",
              "event_date"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Date Axes",
          "type": "array"
        },
        "evidence": {
          "enum": [
            "unconfigured",
            "documented",
            "sample",
            "live_e2e",
            "fixture"
          ],
          "title": "Evidence",
          "type": "string"
        },
        "history_end": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "History End"
        },
        "history_start": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "History Start"
        },
        "instrument_kinds": {
          "items": {
            "enum": [
              "stock",
              "index",
              "etf",
              "future",
              "crypto"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Instrument Kinds",
          "type": "array"
        },
        "kind": {
          "enum": [
            "financial_statement",
            "membership_interval",
            "security_identity_change",
            "corporate_action",
            "adjustment_factor"
          ],
          "title": "Kind",
          "type": "string"
        },
        "knowledge_evidence": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Knowledge Evidence"
        },
        "limitations": {
          "default": [],
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "mapping_version": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Mapping Version",
          "type": "string"
        },
        "markets": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Markets",
          "type": "array"
        },
        "name": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "schema_version": {
          "const": 2,
          "default": 2,
          "title": "Schema Version",
          "type": "integer"
        },
        "source": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "supports_as_of": {
          "default": false,
          "title": "Supports As Of",
          "type": "boolean"
        },
        "timezone": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Timezone",
          "type": "string"
        },
        "unblock_condition": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unblock Condition"
        }
      },
      "required": [
        "source",
        "name",
        "kind",
        "configured",
        "evidence",
        "markets",
        "instrument_kinds",
        "date_axes",
        "timezone",
        "mapping_version"
      ],
      "title": "ResearchCapability",
      "type": "object"
    },
    "ResearchPartition": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "format": "date",
          "title": "End",
          "type": "string"
        },
        "instrument_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Instrument Id",
          "type": "string"
        },
        "schema_version": {
          "const": 2,
          "default": 2,
          "title": "Schema Version",
          "type": "integer"
        },
        "start": {
          "format": "date",
          "title": "Start",
          "type": "string"
        }
      },
      "required": [
        "instrument_id",
        "start",
        "end"
      ],
      "title": "ResearchPartition",
      "type": "object"
    },
    "ResearchPlanRequest": {
      "additionalProperties": false,
      "properties": {
        "actor_id": {
          "format": "uuid",
          "title": "Actor Id",
          "type": "string"
        },
        "correlation_id": {
          "format": "uuid",
          "title": "Correlation Id",
          "type": "string"
        },
        "date_axis": {
          "enum": [
            "report_period",
            "observation_date",
            "effective_date",
            "event_date"
          ],
          "title": "Date Axis",
          "type": "string"
        },
        "end": {
          "format": "date",
          "title": "End",
          "type": "string"
        },
        "instrument_ids": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 10000,
          "minItems": 1,
          "title": "Instrument Ids",
          "type": "array"
        },
        "kind": {
          "enum": [
            "financial_statement",
            "membership_interval",
            "security_identity_change",
            "corporate_action",
            "adjustment_factor"
          ],
          "title": "Kind",
          "type": "string"
        },
        "mode": {
          "default": "missing",
          "enum": [
            "missing",
            "all",
            "review"
          ],
          "title": "Mode",
          "type": "string"
        },
        "request_id": {
          "format": "uuid",
          "title": "Request Id",
          "type": "string"
        },
        "schema_version": {
          "const": 2,
          "default": 2,
          "title": "Schema Version",
          "type": "integer"
        },
        "scope_id": {
          "format": "uuid",
          "title": "Scope Id",
          "type": "string"
        },
        "source": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "start": {
          "format": "date",
          "title": "Start",
          "type": "string"
        }
      },
      "required": [
        "actor_id",
        "scope_id",
        "request_id",
        "correlation_id",
        "source",
        "kind",
        "instrument_ids",
        "date_axis",
        "start",
        "end"
      ],
      "title": "ResearchPlanRequest",
      "type": "object"
    }
  },
  "$id": "urn:qtrade:data:v2:ResearchPlanPreview",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "capability": {
      "$ref": "#/$defs/ResearchCapability"
    },
    "confirmation_required": {
      "title": "Confirmation Required",
      "type": "boolean"
    },
    "control_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Control Sha256",
      "type": "string"
    },
    "estimate_basis": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Estimate Basis",
      "type": "string"
    },
    "estimated_calls_max": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Estimated Calls Max"
    },
    "estimated_calls_min": {
      "minimum": 0,
      "title": "Estimated Calls Min",
      "type": "integer"
    },
    "execution_estimate": {
      "$ref": "#/$defs/CollectionCostEstimate"
    },
    "partitions": {
      "items": {
        "$ref": "#/$defs/ResearchPartition"
      },
      "title": "Partitions",
      "type": "array"
    },
    "plan_guard": {
      "$ref": "#/$defs/CollectionPlanGuard"
    },
    "plan_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Plan Sha256",
      "type": "string"
    },
    "plan_version": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Plan Version",
      "type": "string"
    },
    "request": {
      "$ref": "#/$defs/ResearchPlanRequest"
    },
    "schema_version": {
      "const": 2,
      "default": 2,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "request",
    "capability",
    "partitions",
    "plan_version",
    "plan_sha256",
    "estimated_calls_min",
    "estimated_calls_max",
    "estimate_basis",
    "execution_estimate",
    "plan_guard",
    "confirmation_required",
    "control_sha256"
  ],
  "title": "ResearchPlanPreview",
  "type": "object"
}
