{
  "$defs": {
    "ResearchCapability": {
      "additionalProperties": false,
      "properties": {
        "configured": {
          "title": "Configured",
          "type": "boolean"
        },
        "date_axes": {
          "items": {
            "enum": [
              "report_period",
              "observation_date",
              "effective_date",
              "event_date"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Date Axes",
          "type": "array"
        },
        "evidence": {
          "enum": [
            "unconfigured",
            "documented",
            "sample",
            "live_e2e",
            "fixture"
          ],
          "title": "Evidence",
          "type": "string"
        },
        "history_end": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "History End"
        },
        "history_start": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "History Start"
        },
        "instrument_kinds": {
          "items": {
            "enum": [
              "stock",
              "index",
              "etf",
              "future",
              "crypto"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Instrument Kinds",
          "type": "array"
        },
        "kind": {
          "enum": [
            "financial_statement",
            "membership_interval",
            "security_identity_change",
            "corporate_action",
            "adjustment_factor"
          ],
          "title": "Kind",
          "type": "string"
        },
        "knowledge_evidence": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Knowledge Evidence"
        },
        "limitations": {
          "default": [],
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "mapping_version": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Mapping Version",
          "type": "string"
        },
        "markets": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Markets",
          "type": "array"
        },
        "name": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "schema_version": {
          "const": 2,
          "default": 2,
          "title": "Schema Version",
          "type": "integer"
        },
        "source": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "supports_as_of": {
          "default": false,
          "title": "Supports As Of",
          "type": "boolean"
        },
        "timezone": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Timezone",
          "type": "string"
        },
        "unblock_condition": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unblock Condition"
        }
      },
      "required": [
        "source",
        "name",
        "kind",
        "configured",
        "evidence",
        "markets",
        "instrument_kinds",
        "date_axes",
        "timezone",
        "mapping_version"
      ],
      "title": "ResearchCapability",
      "type": "object"
    },
    "ResearchPartition": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "format": "date",
          "title": "End",
          "type": "string"
        },
        "instrument_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Instrument Id",
          "type": "string"
        },
        "schema_version": {
          "const": 2,
          "default": 2,
          "title": "Schema Version",
          "type": "integer"
        },
        "start": {
          "format": "date",
          "title": "Start",
          "type": "string"
        }
      },
      "required": [
        "instrument_id",
        "start",
        "end"
      ],
      "title": "ResearchPartition",
      "type": "object"
    },
    "ResearchPlan": {
      "additionalProperties": false,
      "properties": {
        "capability": {
          "$ref": "#/$defs/ResearchCapability"
        },
        "estimate_basis": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Estimate Basis",
          "type": "string"
        },
        "estimated_calls_max": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Estimated Calls Max"
        },
        "estimated_calls_min": {
          "minimum": 0,
          "title": "Estimated Calls Min",
          "type": "integer"
        },
        "partitions": {
          "items": {
            "$ref": "#/$defs/ResearchPartition"
          },
          "title": "Partitions",
          "type": "array"
        },
        "plan_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Plan Sha256",
          "type": "string"
        },
        "plan_version": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Plan Version",
          "type": "string"
        },
        "request": {
          "$ref": "#/$defs/ResearchPlanRequest"
        },
        "schema_version": {
          "const": 2,
          "default": 2,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "request",
        "capability",
        "partitions",
        "plan_version",
        "plan_sha256",
        "estimated_calls_min",
        "estimated_calls_max",
        "estimate_basis"
      ],
      "title": "ResearchPlan",
      "type": "object"
    },
    "ResearchPlanRequest": {
      "additionalProperties": false,
      "properties": {
        "actor_id": {
          "format": "uuid",
          "title": "Actor Id",
          "type": "string"
        },
        "correlation_id": {
          "format": "uuid",
          "title": "Correlation Id",
          "type": "string"
        },
        "date_axis": {
          "enum": [
            "report_period",
            "observation_date",
            "effective_date",
            "event_date"
          ],
          "title": "Date Axis",
          "type": "string"
        },
        "end": {
          "format": "date",
          "title": "End",
          "type": "string"
        },
        "instrument_ids": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 10000,
          "minItems": 1,
          "title": "Instrument Ids",
          "type": "array"
        },
        "kind": {
          "enum": [
            "financial_statement",
            "membership_interval",
            "security_identity_change",
            "corporate_action",
            "adjustment_factor"
          ],
          "title": "Kind",
          "type": "string"
        },
        "mode": {
          "default": "missing",
          "enum": [
            "missing",
            "all",
            "review"
          ],
          "title": "Mode",
          "type": "string"
        },
        "request_id": {
          "format": "uuid",
          "title": "Request Id",
          "type": "string"
        },
        "schema_version": {
          "const": 2,
          "default": 2,
          "title": "Schema Version",
          "type": "integer"
        },
        "scope_id": {
          "format": "uuid",
          "title": "Scope Id",
          "type": "string"
        },
        "source": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "start": {
          "format": "date",
          "title": "Start",
          "type": "string"
        }
      },
      "required": [
        "actor_id",
        "scope_id",
        "request_id",
        "correlation_id",
        "source",
        "kind",
        "instrument_ids",
        "date_axis",
        "start",
        "end"
      ],
      "title": "ResearchPlanRequest",
      "type": "object"
    },
    "ResearchRawManifest": {
      "additionalProperties": false,
      "properties": {
        "batch_id": {
          "format": "uuid",
          "title": "Batch Id",
          "type": "string"
        },
        "collected_at": {
          "format": "date-time",
          "title": "Collected At",
          "type": "string"
        },
        "cursor": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Cursor"
        },
        "end": {
          "format": "date",
          "title": "End",
          "type": "string"
        },
        "instrument_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Instrument Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "financial_statement",
            "membership_interval",
            "security_identity_change",
            "corporate_action",
            "adjustment_factor"
          ],
          "title": "Kind",
          "type": "string"
        },
        "next_cursor": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Next Cursor"
        },
        "plan_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Plan Sha256",
          "type": "string"
        },
        "raw_content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Raw Content Sha256",
          "type": "string"
        },
        "raw_record_count": {
          "minimum": 0,
          "title": "Raw Record Count",
          "type": "integer"
        },
        "raw_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Raw Sha256",
          "type": "string"
        },
        "request_id": {
          "format": "uuid",
          "title": "Request Id",
          "type": "string"
        },
        "schema_version": {
          "const": 2,
          "default": 2,
          "title": "Schema Version",
          "type": "integer"
        },
        "scope_id": {
          "format": "uuid",
          "title": "Scope Id",
          "type": "string"
        },
        "source": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "start": {
          "format": "date",
          "title": "Start",
          "type": "string"
        }
      },
      "required": [
        "scope_id",
        "request_id",
        "batch_id",
        "plan_sha256",
        "source",
        "kind",
        "instrument_id",
        "start",
        "end",
        "cursor",
        "next_cursor",
        "collected_at",
        "raw_sha256",
        "raw_content_sha256",
        "raw_record_count"
      ],
      "title": "ResearchRawManifest",
      "type": "object"
    },
    "ResearchReplayLimits": {
      "additionalProperties": false,
      "properties": {
        "max_bytes": {
          "default": 67108864,
          "maximum": 67108864,
          "minimum": 1,
          "title": "Max Bytes",
          "type": "integer"
        },
        "max_pages": {
          "default": 1000,
          "maximum": 1000,
          "minimum": 1,
          "title": "Max Pages",
          "type": "integer"
        },
        "max_rows": {
          "default": 100000,
          "maximum": 100000,
          "minimum": 1,
          "title": "Max Rows",
          "type": "integer"
        },
        "schema_version": {
          "const": 2,
          "default": 2,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "title": "ResearchReplayLimits",
      "type": "object"
    },
    "ResearchReplayRequest": {
      "additionalProperties": false,
      "properties": {
        "actor_id": {
          "format": "uuid",
          "title": "Actor Id",
          "type": "string"
        },
        "parent_request_id": {
          "format": "uuid",
          "title": "Parent Request Id",
          "type": "string"
        },
        "request_id": {
          "format": "uuid",
          "title": "Request Id",
          "type": "string"
        },
        "schema_version": {
          "const": 2,
          "default": 2,
          "title": "Schema Version",
          "type": "integer"
        },
        "scope_id": {
          "format": "uuid",
          "title": "Scope Id",
          "type": "string"
        }
      },
      "required": [
        "actor_id",
        "scope_id",
        "request_id",
        "parent_request_id"
      ],
      "title": "ResearchReplayRequest",
      "type": "object"
    }
  },
  "$id": "urn:qtrade:data:v2:ResearchReplay",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "command": {
      "$ref": "#/$defs/ResearchReplayRequest"
    },
    "control_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Control Sha256",
      "type": "string"
    },
    "limits": {
      "$ref": "#/$defs/ResearchReplayLimits"
    },
    "parent_plan": {
      "$ref": "#/$defs/ResearchPlan"
    },
    "replay_version": {
      "const": "research-raw-replay.v1",
      "default": "research-raw-replay.v1",
      "title": "Replay Version",
      "type": "string"
    },
    "schema_version": {
      "const": 2,
      "default": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "source_batches": {
      "items": {
        "$ref": "#/$defs/ResearchRawManifest"
      },
      "maxItems": 1000,
      "minItems": 1,
      "title": "Source Batches",
      "type": "array"
    },
    "target_plan": {
      "$ref": "#/$defs/ResearchPlan"
    }
  },
  "required": [
    "command",
    "parent_plan",
    "target_plan",
    "source_batches",
    "limits",
    "control_sha256"
  ],
  "title": "ResearchReplay",
  "type": "object"
}
