{
  "$defs": {
    "BarNormalizationInput": {
      "additionalProperties": false,
      "properties": {
        "calendar_days": {
          "anyOf": [
            {
              "items": {
                "format": "date",
                "type": "string"
              },
              "maxItems": 10000,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Calendar Days"
        },
        "fetch_mechanisms": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Fetch Mechanisms",
          "type": "array"
        },
        "kind": {
          "const": "bars",
          "default": "bars",
          "title": "Kind",
          "type": "string"
        },
        "slices": {
          "items": {
            "$ref": "#/$defs/BarSourceSlice"
          },
          "maxItems": 1000,
          "minItems": 1,
          "title": "Slices",
          "type": "array"
        }
      },
      "required": [
        "slices",
        "calendar_days",
        "fetch_mechanisms"
      ],
      "title": "BarNormalizationInput",
      "type": "object"
    },
    "BarSourceSlice": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "format": "date-time",
          "title": "End",
          "type": "string"
        },
        "rows": {
          "items": {
            "additionalProperties": {
              "$ref": "#/$defs/JsonValue"
            },
            "type": "object"
          },
          "maxItems": 100000,
          "title": "Rows",
          "type": "array"
        },
        "start": {
          "format": "date-time",
          "title": "Start",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end",
        "rows"
      ],
      "title": "BarSourceSlice",
      "type": "object"
    },
    "CollectionJobRequest": {
      "additionalProperties": false,
      "properties": {
        "actor_id": {
          "format": "uuid",
          "title": "Actor Id",
          "type": "string"
        },
        "correlation_id": {
          "format": "uuid",
          "title": "Correlation Id",
          "type": "string"
        },
        "dataset_kind": {
          "enum": [
            "bars",
            "factors"
          ],
          "title": "Dataset Kind",
          "type": "string"
        },
        "end": {
          "format": "date-time",
          "title": "End",
          "type": "string"
        },
        "fields": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 200,
          "title": "Fields",
          "type": "array"
        },
        "granularity": {
          "enum": [
            "1m",
            "5m",
            "15m",
            "30m",
            "1h",
            "1d"
          ],
          "title": "Granularity",
          "type": "string"
        },
        "instrument_ids": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 10000,
          "minItems": 1,
          "title": "Instrument Ids",
          "type": "array"
        },
        "mode": {
          "default": "missing",
          "enum": [
            "missing",
            "all"
          ],
          "title": "Mode",
          "type": "string"
        },
        "request_id": {
          "format": "uuid",
          "title": "Request Id",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "scope_id": {
          "format": "uuid",
          "title": "Scope Id",
          "type": "string"
        },
        "source": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "start": {
          "format": "date-time",
          "title": "Start",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "scope_id",
        "request_id",
        "actor_id",
        "correlation_id",
        "source",
        "dataset_kind",
        "instrument_ids",
        "granularity",
        "start",
        "end"
      ],
      "title": "CollectionJobRequest",
      "type": "object"
    },
    "FactorDefinition": {
      "additionalProperties": false,
      "properties": {
        "available": {
          "title": "Available",
          "type": "boolean"
        },
        "calc_version": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Calc Version",
          "type": "string"
        },
        "category": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Category",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "factor_id": {
          "pattern": "^[a-zA-Z0-9_]{1,80}$",
          "title": "Factor Id",
          "type": "string"
        },
        "name": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "unavailable_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unavailable Reason"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "update_frequency": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Update Frequency",
          "type": "string"
        }
      },
      "required": [
        "factor_id",
        "name",
        "category",
        "unit",
        "description",
        "calc_version",
        "update_frequency",
        "available"
      ],
      "title": "FactorDefinition",
      "type": "object"
    },
    "FactorNormalizationInput": {
      "additionalProperties": false,
      "properties": {
        "definition": {
          "$ref": "#/$defs/FactorDefinition"
        },
        "kind": {
          "const": "factors",
          "default": "factors",
          "title": "Kind",
          "type": "string"
        },
        "rows": {
          "items": {
            "additionalProperties": {
              "$ref": "#/$defs/JsonValue"
            },
            "type": "object"
          },
          "maxItems": 365,
          "title": "Rows",
          "type": "array"
        },
        "value_kinds": {
          "items": {
            "enum": [
              "number",
              "signal",
              "missing"
            ],
            "type": "string"
          },
          "maxItems": 365,
          "title": "Value Kinds",
          "type": "array"
        }
      },
      "required": [
        "rows",
        "definition",
        "value_kinds"
      ],
      "title": "FactorNormalizationInput",
      "type": "object"
    },
    "JsonValue": {}
  },
  "$id": "urn:qtrade:data:v2:CollectionNormalizationInput",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "end": {
      "format": "date-time",
      "title": "End",
      "type": "string"
    },
    "field": {
      "anyOf": [
        {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Field"
    },
    "format_version": {
      "const": "collection-normalization-input.v1",
      "default": "collection-normalization-input.v1",
      "title": "Format Version",
      "type": "string"
    },
    "input_id": {
      "format": "uuid",
      "title": "Input Id",
      "type": "string"
    },
    "input_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Sha256",
      "type": "string"
    },
    "instrument_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Instrument Id",
      "type": "string"
    },
    "instrument_name": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Instrument Name",
      "type": "string"
    },
    "job_id": {
      "format": "uuid",
      "title": "Job Id",
      "type": "string"
    },
    "mapping_version": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Mapping Version",
      "type": "string"
    },
    "part_id": {
      "format": "uuid",
      "title": "Part Id",
      "type": "string"
    },
    "payload": {
      "discriminator": {
        "mapping": {
          "bars": "#/$defs/BarNormalizationInput",
          "factors": "#/$defs/FactorNormalizationInput"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/BarNormalizationInput"
        },
        {
          "$ref": "#/$defs/FactorNormalizationInput"
        }
      ],
      "title": "Payload"
    },
    "prepared_at": {
      "format": "date-time",
      "title": "Prepared At",
      "type": "string"
    },
    "raw_capture_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "maxItems": 4096,
      "minItems": 1,
      "title": "Raw Capture Ids",
      "type": "array"
    },
    "request": {
      "$ref": "#/$defs/CollectionJobRequest"
    },
    "schema_version": {
      "const": 2,
      "default": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "start": {
      "format": "date-time",
      "title": "Start",
      "type": "string"
    }
  },
  "required": [
    "input_id",
    "request",
    "job_id",
    "part_id",
    "instrument_id",
    "field",
    "start",
    "end",
    "mapping_version",
    "instrument_name",
    "raw_capture_ids",
    "payload",
    "prepared_at",
    "input_sha256"
  ],
  "title": "CollectionNormalizationInput",
  "type": "object"
}
