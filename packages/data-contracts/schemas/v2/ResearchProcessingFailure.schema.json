{
  "$id": "urn:qtrade:data:v2:ResearchProcessingFailure",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "batch_id": {
      "format": "uuid",
      "title": "Batch Id",
      "type": "string"
    },
    "checker_version": {
      "const": "research-normalization-check.v1",
      "title": "Checker Version",
      "type": "string"
    },
    "error_code": {
      "const": "unverified",
      "title": "Error Code",
      "type": "string"
    },
    "failed_at": {
      "format": "date-time",
      "title": "Failed At",
      "type": "string"
    },
    "failure_id": {
      "format": "uuid",
      "title": "Failure Id",
      "type": "string"
    },
    "kind": {
      "enum": [
        "financial_statement",
        "membership_interval",
        "security_identity_change",
        "corporate_action",
        "adjustment_factor"
      ],
      "title": "Kind",
      "type": "string"
    },
    "mapping_version": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Mapping Version",
      "type": "string"
    },
    "normalized_record_count": {
      "default": null,
      "title": "Normalized Record Count",
      "type": "null"
    },
    "plan_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Plan Sha256",
      "type": "string"
    },
    "raw_content_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Raw Content Sha256",
      "type": "string"
    },
    "raw_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Raw Sha256",
      "type": "string"
    },
    "request_id": {
      "format": "uuid",
      "title": "Request Id",
      "type": "string"
    },
    "schema_version": {
      "const": 2,
      "default": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "scope_id": {
      "format": "uuid",
      "title": "Scope Id",
      "type": "string"
    },
    "source": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Source",
      "type": "string"
    },
    "stage": {
      "const": "normalization",
      "title": "Stage",
      "type": "string"
    },
    "status": {
      "const": "blocked",
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "failure_id",
    "scope_id",
    "request_id",
    "batch_id",
    "plan_sha256",
    "raw_sha256",
    "raw_content_sha256",
    "source",
    "kind",
    "mapping_version",
    "checker_version",
    "stage",
    "error_code",
    "status",
    "failed_at"
  ],
  "title": "ResearchProcessingFailure",
  "type": "object"
}
