{
  "$id": "urn:qtrade:data:v2:ResearchSubmission",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actor_id": {
      "format": "uuid",
      "title": "Actor Id",
      "type": "string"
    },
    "confirmed": {
      "default": false,
      "title": "Confirmed",
      "type": "boolean"
    },
    "control_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Control Sha256"
    },
    "correlation_id": {
      "format": "uuid",
      "title": "Correlation Id",
      "type": "string"
    },
    "date_axis": {
      "enum": [
        "report_period",
        "observation_date",
        "effective_date",
        "event_date"
      ],
      "title": "Date Axis",
      "type": "string"
    },
    "end": {
      "format": "date",
      "title": "End",
      "type": "string"
    },
    "instrument_ids": {
      "items": {
        "maxLength": 256,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 10000,
      "minItems": 1,
      "title": "Instrument Ids",
      "type": "array"
    },
    "kind": {
      "enum": [
        "financial_statement",
        "membership_interval",
        "security_identity_change",
        "corporate_action",
        "adjustment_factor"
      ],
      "title": "Kind",
      "type": "string"
    },
    "mode": {
      "default": "missing",
      "enum": [
        "missing",
        "all",
        "review"
      ],
      "title": "Mode",
      "type": "string"
    },
    "request_id": {
      "format": "uuid",
      "title": "Request Id",
      "type": "string"
    },
    "schema_version": {
      "const": 2,
      "default": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "scope_id": {
      "format": "uuid",
      "title": "Scope Id",
      "type": "string"
    },
    "source": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Source",
      "type": "string"
    },
    "start": {
      "format": "date",
      "title": "Start",
      "type": "string"
    }
  },
  "required": [
    "actor_id",
    "scope_id",
    "request_id",
    "correlation_id",
    "source",
    "kind",
    "instrument_ids",
    "date_axis",
    "start",
    "end"
  ],
  "title": "ResearchSubmission",
  "type": "object"
}
