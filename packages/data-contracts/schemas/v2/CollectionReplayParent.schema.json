{
  "$defs": {
    "CollectionJobRequest": {
      "additionalProperties": false,
      "properties": {
        "actor_id": {
          "format": "uuid",
          "title": "Actor Id",
          "type": "string"
        },
        "correlation_id": {
          "format": "uuid",
          "title": "Correlation Id",
          "type": "string"
        },
        "dataset_kind": {
          "enum": [
            "bars",
            "factors"
          ],
          "title": "Dataset Kind",
          "type": "string"
        },
        "end": {
          "format": "date-time",
          "title": "End",
          "type": "string"
        },
        "fields": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 200,
          "title": "Fields",
          "type": "array"
        },
        "granularity": {
          "enum": [
            "1m",
            "5m",
            "15m",
            "30m",
            "1h",
            "1d"
          ],
          "title": "Granularity",
          "type": "string"
        },
        "instrument_ids": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 10000,
          "minItems": 1,
          "title": "Instrument Ids",
          "type": "array"
        },
        "mode": {
          "default": "missing",
          "enum": [
            "missing",
            "all"
          ],
          "title": "Mode",
          "type": "string"
        },
        "request_id": {
          "format": "uuid",
          "title": "Request Id",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "scope_id": {
          "format": "uuid",
          "title": "Scope Id",
          "type": "string"
        },
        "source": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "start": {
          "format": "date-time",
          "title": "Start",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "scope_id",
        "request_id",
        "actor_id",
        "correlation_id",
        "source",
        "dataset_kind",
        "instrument_ids",
        "granularity",
        "start",
        "end"
      ],
      "title": "CollectionJobRequest",
      "type": "object"
    }
  },
  "$id": "urn:qtrade:data:v2:CollectionReplayParent",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "end": {
      "format": "date-time",
      "title": "End",
      "type": "string"
    },
    "execution_kind": {
      "enum": [
        "collection",
        "normalization_replay"
      ],
      "title": "Execution Kind",
      "type": "string"
    },
    "field": {
      "anyOf": [
        {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Field"
    },
    "instrument_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Instrument Id",
      "type": "string"
    },
    "instrument_name": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Instrument Name",
      "type": "string"
    },
    "job_id": {
      "format": "uuid",
      "title": "Job Id",
      "type": "string"
    },
    "mapping_version": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Mapping Version",
      "type": "string"
    },
    "part_id": {
      "format": "uuid",
      "title": "Part Id",
      "type": "string"
    },
    "request": {
      "$ref": "#/$defs/CollectionJobRequest"
    },
    "schema_version": {
      "const": 2,
      "default": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "start": {
      "format": "date-time",
      "title": "Start",
      "type": "string"
    }
  },
  "required": [
    "request",
    "job_id",
    "part_id",
    "instrument_id",
    "field",
    "start",
    "end",
    "mapping_version",
    "instrument_name",
    "execution_kind"
  ],
  "title": "CollectionReplayParent",
  "type": "object"
}
