{
  "$id": "urn:qtrade:data:v1:SourceDataset",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "configured": {
      "title": "Configured",
      "type": "boolean"
    },
    "dataset_kind": {
      "enum": [
        "bars",
        "factors"
      ],
      "title": "Dataset Kind",
      "type": "string"
    },
    "earliest": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Earliest"
    },
    "evidence": {
      "enum": [
        "documented",
        "configured",
        "sample_verified",
        "e2e_verified",
        "blocked"
      ],
      "title": "Evidence",
      "type": "string"
    },
    "instrument_kinds": {
      "items": {
        "enum": [
          "stock",
          "index",
          "etf",
          "future",
          "crypto"
        ],
        "type": "string"
      },
      "title": "Instrument Kinds",
      "type": "array"
    },
    "limitations": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "mapping_version": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Mapping Version",
      "type": "string"
    },
    "markets": {
      "items": {
        "maxLength": 256,
        "minLength": 1,
        "type": "string"
      },
      "title": "Markets",
      "type": "array"
    },
    "name": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "periods": {
      "items": {
        "enum": [
          "1m",
          "5m",
          "15m",
          "30m",
          "1h",
          "1d"
        ],
        "type": "string"
      },
      "title": "Periods",
      "type": "array"
    },
    "provider": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Provider",
      "type": "string"
    },
    "source": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Source",
      "type": "string"
    },
    "timezone": {
      "default": "UTC",
      "maxLength": 256,
      "minLength": 1,
      "title": "Timezone",
      "type": "string"
    }
  },
  "required": [
    "source",
    "provider",
    "name",
    "dataset_kind",
    "periods",
    "instrument_kinds",
    "markets",
    "configured",
    "evidence",
    "mapping_version"
  ],
  "title": "SourceDataset",
  "type": "object"
}
