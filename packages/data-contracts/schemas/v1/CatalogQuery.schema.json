{
  "$id": "urn:qtrade:data:v1:CatalogQuery",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "cursor": {
      "anyOf": [
        {
          "maxLength": 2048,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cursor"
    },
    "dataset_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Dataset Id"
    },
    "end": {
      "format": "date-time",
      "title": "End",
      "type": "string"
    },
    "granularity": {
      "enum": [
        "1m",
        "5m",
        "15m",
        "1h",
        "1d"
      ],
      "title": "Granularity",
      "type": "string"
    },
    "instrument_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Instrument Id",
      "type": "string"
    },
    "limit": {
      "default": 1000,
      "maximum": 10000,
      "minimum": 1,
      "title": "Limit",
      "type": "integer"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "scope_id": {
      "format": "uuid",
      "title": "Scope Id",
      "type": "string"
    },
    "start": {
      "format": "date-time",
      "title": "Start",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "scope_id",
    "instrument_id",
    "granularity",
    "start",
    "end"
  ],
  "title": "CatalogQuery",
  "type": "object"
}
