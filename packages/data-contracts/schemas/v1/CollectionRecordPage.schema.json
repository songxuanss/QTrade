{
  "$defs": {
    "CollectedBar": {
      "additionalProperties": false,
      "properties": {
        "close": {
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "title": "Close",
          "type": "string"
        },
        "granularity": {
          "enum": [
            "1m",
            "5m",
            "15m",
            "30m",
            "1h",
            "1d"
          ],
          "title": "Granularity",
          "type": "string"
        },
        "high": {
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "title": "High",
          "type": "string"
        },
        "instrument_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Instrument Id",
          "type": "string"
        },
        "low": {
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "title": "Low",
          "type": "string"
        },
        "open": {
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "title": "Open",
          "type": "string"
        },
        "quality": {
          "default": "valid",
          "enum": [
            "valid",
            "suspect"
          ],
          "title": "Quality",
          "type": "string"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "volume": {
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "title": "Volume",
          "type": "string"
        }
      },
      "required": [
        "instrument_id",
        "timestamp",
        "granularity",
        "open",
        "high",
        "low",
        "close",
        "volume",
        "value"
      ],
      "title": "CollectedBar",
      "type": "object"
    },
    "FactorPoint": {
      "additionalProperties": false,
      "properties": {
        "availability_evidence": {
          "default": "unknown",
          "enum": [
            "unknown",
            "provider_timestamp"
          ],
          "title": "Availability Evidence",
          "type": "string"
        },
        "available_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Available At"
        },
        "calc_version": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Calc Version",
          "type": "string"
        },
        "factor_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Factor Id",
          "type": "string"
        },
        "instrument_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Instrument Id",
          "type": "string"
        },
        "missing_reason": {
          "anyOf": [
            {
              "enum": [
                "provider_null",
                "not_available"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Missing Reason"
        },
        "trade_date": {
          "format": "date",
          "title": "Trade Date",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
              "type": "string"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "value_kind": {
          "enum": [
            "number",
            "signal",
            "missing"
          ],
          "title": "Value Kind",
          "type": "string"
        }
      },
      "required": [
        "instrument_id",
        "factor_id",
        "trade_date",
        "value",
        "value_kind",
        "calc_version"
      ],
      "title": "FactorPoint",
      "type": "object"
    }
  },
  "$id": "urn:qtrade:data:v1:CollectionRecordPage",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "next_offset": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Next Offset"
    },
    "offset": {
      "minimum": 0,
      "title": "Offset",
      "type": "integer"
    },
    "page_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Page Sha256",
      "type": "string"
    },
    "publication_id": {
      "format": "uuid",
      "title": "Publication Id",
      "type": "string"
    },
    "records": {
      "items": {
        "anyOf": [
          {
            "$ref": "#/$defs/CollectedBar"
          },
          {
            "$ref": "#/$defs/FactorPoint"
          }
        ]
      },
      "maxItems": 1000,
      "title": "Records",
      "type": "array"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "scope_id": {
      "format": "uuid",
      "title": "Scope Id",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "scope_id",
    "publication_id",
    "records",
    "offset",
    "next_offset",
    "page_sha256"
  ],
  "title": "CollectionRecordPage",
  "type": "object"
}
