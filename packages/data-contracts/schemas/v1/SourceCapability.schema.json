{
  "$id": "urn:qtrade:data:v1:SourceCapability",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authorization_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Authorization Id",
      "type": "string"
    },
    "earliest": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Earliest"
    },
    "granularities": {
      "items": {
        "enum": [
          "tick",
          "1m",
          "5m",
          "15m",
          "1h",
          "1d"
        ],
        "type": "string"
      },
      "title": "Granularities",
      "type": "array"
    },
    "instrument_kinds": {
      "items": {
        "enum": [
          "stock",
          "index"
        ],
        "type": "string"
      },
      "title": "Instrument Kinds",
      "type": "array"
    },
    "latest": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Latest"
    },
    "observed_at": {
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "scope_id": {
      "format": "uuid",
      "title": "Scope Id",
      "type": "string"
    },
    "source": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Source",
      "type": "string"
    },
    "verification": {
      "enum": [
        "verified",
        "unverified",
        "unavailable"
      ],
      "title": "Verification",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "scope_id",
    "source",
    "authorization_id",
    "instrument_kinds",
    "granularities",
    "verification",
    "observed_at"
  ],
  "title": "SourceCapability",
  "type": "object"
}
