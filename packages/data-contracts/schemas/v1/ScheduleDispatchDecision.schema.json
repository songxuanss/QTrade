{
  "$defs": {
    "CollectionJobRequest": {
      "additionalProperties": false,
      "properties": {
        "actor_id": {
          "format": "uuid",
          "title": "Actor Id",
          "type": "string"
        },
        "correlation_id": {
          "format": "uuid",
          "title": "Correlation Id",
          "type": "string"
        },
        "dataset_kind": {
          "enum": [
            "bars",
            "factors"
          ],
          "title": "Dataset Kind",
          "type": "string"
        },
        "end": {
          "format": "date-time",
          "title": "End",
          "type": "string"
        },
        "fields": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 200,
          "title": "Fields",
          "type": "array"
        },
        "granularity": {
          "enum": [
            "1m",
            "5m",
            "15m",
            "30m",
            "1h",
            "1d"
          ],
          "title": "Granularity",
          "type": "string"
        },
        "instrument_ids": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 10000,
          "minItems": 1,
          "title": "Instrument Ids",
          "type": "array"
        },
        "mode": {
          "default": "missing",
          "enum": [
            "missing",
            "all"
          ],
          "title": "Mode",
          "type": "string"
        },
        "request_id": {
          "format": "uuid",
          "title": "Request Id",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "scope_id": {
          "format": "uuid",
          "title": "Scope Id",
          "type": "string"
        },
        "source": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "start": {
          "format": "date-time",
          "title": "Start",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "scope_id",
        "request_id",
        "actor_id",
        "correlation_id",
        "source",
        "dataset_kind",
        "instrument_ids",
        "granularity",
        "start",
        "end"
      ],
      "title": "CollectionJobRequest",
      "type": "object"
    },
    "MarketDispatchInput": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "market",
          "title": "Kind",
          "type": "string"
        },
        "request": {
          "$ref": "#/$defs/CollectionJobRequest"
        }
      },
      "required": [
        "kind",
        "request"
      ],
      "title": "MarketDispatchInput",
      "type": "object"
    },
    "ResearchDispatchInput": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "research",
          "title": "Kind",
          "type": "string"
        },
        "request": {
          "$ref": "#/$defs/ResearchPlanRequest"
        }
      },
      "required": [
        "kind",
        "request"
      ],
      "title": "ResearchDispatchInput",
      "type": "object"
    },
    "ResearchPlanRequest": {
      "additionalProperties": false,
      "properties": {
        "actor_id": {
          "format": "uuid",
          "title": "Actor Id",
          "type": "string"
        },
        "correlation_id": {
          "format": "uuid",
          "title": "Correlation Id",
          "type": "string"
        },
        "date_axis": {
          "enum": [
            "report_period",
            "observation_date",
            "effective_date",
            "event_date"
          ],
          "title": "Date Axis",
          "type": "string"
        },
        "end": {
          "format": "date",
          "title": "End",
          "type": "string"
        },
        "instrument_ids": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 10000,
          "minItems": 1,
          "title": "Instrument Ids",
          "type": "array"
        },
        "kind": {
          "enum": [
            "financial_statement",
            "membership_interval",
            "security_identity_change",
            "corporate_action",
            "adjustment_factor"
          ],
          "title": "Kind",
          "type": "string"
        },
        "mode": {
          "default": "missing",
          "enum": [
            "missing",
            "all",
            "review"
          ],
          "title": "Mode",
          "type": "string"
        },
        "request_id": {
          "format": "uuid",
          "title": "Request Id",
          "type": "string"
        },
        "schema_version": {
          "const": 2,
          "default": 2,
          "title": "Schema Version",
          "type": "integer"
        },
        "scope_id": {
          "format": "uuid",
          "title": "Scope Id",
          "type": "string"
        },
        "source": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "start": {
          "format": "date",
          "title": "Start",
          "type": "string"
        }
      },
      "required": [
        "actor_id",
        "scope_id",
        "request_id",
        "correlation_id",
        "source",
        "kind",
        "instrument_ids",
        "date_axis",
        "start",
        "end"
      ],
      "title": "ResearchPlanRequest",
      "type": "object"
    }
  },
  "$id": "urn:qtrade:data:v1:ScheduleDispatchDecision",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "basis": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Basis",
      "type": "string"
    },
    "dispatch": {
      "discriminator": {
        "mapping": {
          "market": "#/$defs/MarketDispatchInput",
          "research": "#/$defs/ResearchDispatchInput"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/MarketDispatchInput"
        },
        {
          "$ref": "#/$defs/ResearchDispatchInput"
        }
      ],
      "title": "Dispatch"
    },
    "due_at": {
      "format": "date-time",
      "title": "Due At",
      "type": "string"
    },
    "frozen_at": {
      "format": "date-time",
      "title": "Frozen At",
      "type": "string"
    },
    "policy_version": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Policy Version",
      "type": "string"
    },
    "revision": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Revision",
      "type": "string"
    },
    "run_id": {
      "format": "uuid",
      "title": "Run Id",
      "type": "string"
    },
    "schedule_id": {
      "format": "uuid",
      "title": "Schedule Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "scope_id": {
      "format": "uuid",
      "title": "Scope Id",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "scope_id",
    "schedule_id",
    "run_id",
    "revision",
    "due_at",
    "policy_version",
    "basis",
    "dispatch",
    "frozen_at"
  ],
  "title": "ScheduleDispatchDecision",
  "type": "object"
}
