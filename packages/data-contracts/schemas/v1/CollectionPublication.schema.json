{
  "$id": "urn:qtrade:data:v1:CollectionPublication",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actor_id": {
      "format": "uuid",
      "title": "Actor Id",
      "type": "string"
    },
    "correlation_id": {
      "format": "uuid",
      "title": "Correlation Id",
      "type": "string"
    },
    "dataset_kind": {
      "enum": [
        "bars",
        "factors"
      ],
      "title": "Dataset Kind",
      "type": "string"
    },
    "end": {
      "format": "date-time",
      "title": "End",
      "type": "string"
    },
    "evidence": {
      "additionalProperties": true,
      "default": {},
      "title": "Evidence",
      "type": "object"
    },
    "field": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Field"
    },
    "granularity": {
      "enum": [
        "1m",
        "5m",
        "15m",
        "30m",
        "1h",
        "1d"
      ],
      "title": "Granularity",
      "type": "string"
    },
    "instrument_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Instrument Id",
      "type": "string"
    },
    "instrument_name": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Instrument Name",
      "type": "string"
    },
    "job_id": {
      "format": "uuid",
      "title": "Job Id",
      "type": "string"
    },
    "limitations": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "mapping_version": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Mapping Version",
      "type": "string"
    },
    "part_id": {
      "format": "uuid",
      "title": "Part Id",
      "type": "string"
    },
    "publication_id": {
      "format": "uuid",
      "title": "Publication Id",
      "type": "string"
    },
    "published_at": {
      "format": "date-time",
      "title": "Published At",
      "type": "string"
    },
    "raw_record_count": {
      "minimum": 1,
      "title": "Raw Record Count",
      "type": "integer"
    },
    "raw_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Raw Sha256",
      "type": "string"
    },
    "record_count": {
      "minimum": 1,
      "title": "Record Count",
      "type": "integer"
    },
    "records_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Records Sha256",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "scope_id": {
      "format": "uuid",
      "title": "Scope Id",
      "type": "string"
    },
    "source": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Source",
      "type": "string"
    },
    "source_time_convention": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Source Time Convention",
      "type": "string"
    },
    "start": {
      "format": "date-time",
      "title": "Start",
      "type": "string"
    },
    "units": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Units",
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "scope_id",
    "publication_id",
    "job_id",
    "part_id",
    "actor_id",
    "correlation_id",
    "source",
    "dataset_kind",
    "instrument_id",
    "instrument_name",
    "granularity",
    "start",
    "end",
    "mapping_version",
    "raw_sha256",
    "records_sha256",
    "raw_record_count",
    "record_count",
    "published_at",
    "units",
    "source_time_convention"
  ],
  "title": "CollectionPublication",
  "type": "object"
}
