{
  "$defs": {
    "CollectionScheduleDraft": {
      "additionalProperties": false,
      "properties": {
        "actor_id": {
          "format": "uuid",
          "title": "Actor Id",
          "type": "string"
        },
        "approved_credits": {
          "maximum": 1000000000,
          "minimum": 1,
          "title": "Approved Credits",
          "type": "integer"
        },
        "approved_parts": {
          "maximum": 1000000,
          "minimum": 1,
          "title": "Approved Parts",
          "type": "integer"
        },
        "automation_confirmed": {
          "title": "Automation Confirmed",
          "type": "boolean"
        },
        "cadence": {
          "enum": [
            "daily",
            "weekly",
            "quarterly"
          ],
          "title": "Cadence",
          "type": "string"
        },
        "catchup_days": {
          "default": 7,
          "maximum": 31,
          "minimum": 1,
          "title": "Catchup Days",
          "type": "integer"
        },
        "local_time": {
          "format": "time",
          "title": "Local Time",
          "type": "string"
        },
        "lookback_days": {
          "default": 366,
          "maximum": 3660,
          "minimum": 1,
          "title": "Lookback Days",
          "type": "integer"
        },
        "name": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "schedule_id": {
          "format": "uuid",
          "title": "Schedule Id",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "scope_id": {
          "format": "uuid",
          "title": "Scope Id",
          "type": "string"
        },
        "selection": {
          "discriminator": {
            "mapping": {
              "market": "#/$defs/MarketScheduleSelection",
              "research": "#/$defs/ResearchScheduleSelection"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/MarketScheduleSelection"
            },
            {
              "$ref": "#/$defs/ResearchScheduleSelection"
            }
          ],
          "title": "Selection"
        },
        "timezone": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Timezone",
          "type": "string"
        },
        "weekday": {
          "default": 4,
          "maximum": 6,
          "minimum": 0,
          "title": "Weekday",
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "scope_id",
        "schedule_id",
        "actor_id",
        "name",
        "selection",
        "cadence",
        "timezone",
        "local_time",
        "approved_parts",
        "approved_credits",
        "automation_confirmed"
      ],
      "title": "CollectionScheduleDraft",
      "type": "object"
    },
    "MarketScheduleSelection": {
      "additionalProperties": false,
      "properties": {
        "dataset_kind": {
          "enum": [
            "bars",
            "factors"
          ],
          "title": "Dataset Kind",
          "type": "string"
        },
        "fields": {
          "default": [],
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 200,
          "title": "Fields",
          "type": "array"
        },
        "granularity": {
          "enum": [
            "1m",
            "5m",
            "15m",
            "30m",
            "1h",
            "1d"
          ],
          "title": "Granularity",
          "type": "string"
        },
        "instrument_ids": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 10000,
          "minItems": 1,
          "title": "Instrument Ids",
          "type": "array"
        },
        "kind": {
          "const": "market",
          "title": "Kind",
          "type": "string"
        },
        "membership_content_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Membership Content Sha256"
        },
        "membership_snapshot_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Membership Snapshot Id"
        },
        "source": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "source",
        "instrument_ids",
        "kind",
        "dataset_kind",
        "granularity"
      ],
      "title": "MarketScheduleSelection",
      "type": "object"
    },
    "ResearchScheduleSelection": {
      "additionalProperties": false,
      "properties": {
        "dataset_kind": {
          "enum": [
            "financial_statement",
            "membership_interval",
            "security_identity_change",
            "corporate_action",
            "adjustment_factor"
          ],
          "title": "Dataset Kind",
          "type": "string"
        },
        "date_axis": {
          "enum": [
            "report_period",
            "observation_date",
            "effective_date",
            "event_date"
          ],
          "title": "Date Axis",
          "type": "string"
        },
        "instrument_ids": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 10000,
          "minItems": 1,
          "title": "Instrument Ids",
          "type": "array"
        },
        "kind": {
          "const": "research",
          "title": "Kind",
          "type": "string"
        },
        "membership_content_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Membership Content Sha256"
        },
        "membership_snapshot_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Membership Snapshot Id"
        },
        "source": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "source",
        "instrument_ids",
        "kind",
        "dataset_kind",
        "date_axis"
      ],
      "title": "ResearchScheduleSelection",
      "type": "object"
    }
  },
  "$id": "urn:qtrade:data:v1:CollectionScheduleRecord",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "draft": {
      "$ref": "#/$defs/CollectionScheduleDraft"
    },
    "next_due_at": {
      "format": "date-time",
      "title": "Next Due At",
      "type": "string"
    },
    "pause_reason": {
      "anyOf": [
        {
          "enum": [
            "authorization",
            "source_unavailable",
            "approval_required"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Pause Reason"
    },
    "revision": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Revision",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "scope_id": {
      "format": "uuid",
      "title": "Scope Id",
      "type": "string"
    },
    "state": {
      "enum": [
        "disabled",
        "enabled",
        "paused"
      ],
      "title": "State",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "scope_id",
    "draft",
    "revision",
    "state",
    "next_due_at",
    "updated_at"
  ],
  "title": "CollectionScheduleRecord",
  "type": "object"
}
