{
  "name": "@qtrade/web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "predev": "node scripts/copy-monaco.mjs",
    "build": "next build",
    "prebuild": "node scripts/copy-monaco.mjs",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test",
    "test:production": "node tests/production-smoke.mjs",
    "test:auth": "playwright test --config playwright.auth.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@monaco-editor/react": "^4.7.0",
    "jose": "^6.2.12",
    "monaco-editor": "^0.57.0",
    "next": "^16.4.3",
    "openid-client": "^6.8.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "overrides": {
    "dompurify": "3.4.17"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.0.0",
    "eslint-config-prettier": "^10.0.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.0.0",
    "typescript": "^5.9.0",
    "vitest": "5.0.3"
  },
  "type": "module"
}
