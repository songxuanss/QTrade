# Byte-pinned font set for Playwright pixel snapshots.
# Provisioned by scripts/provision-snapshot-fonts.sh into .tools/snapshot-fonts/
# and rendered from by the FONTCONFIG_FILE that apps/web/tests/font-env.ts
