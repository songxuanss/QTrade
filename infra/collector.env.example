# Copy to .env.collector (git ignored); chmod 600 .env.collector.
COLLECTOR_DB_PASSWORD=replace-with-strong-random-password
COLLECTOR_SERVICE_TOKEN=replace-with-at-least-32-random-characters
COLLECTOR_AUTHORIZER_URL=https://qtrade.example/internal/data/authorize
COLLECTOR_ALLOW_HTTP=false
COLLECTOR_MAIRUI_PRO_ENABLED=true
COLLECTOR_SOURCE_INTERVAL_SECONDS=3
# 0: no extra operator cap; provider year boundaries and factor limits still apply.
COLLECTOR_MAIRUI_PARTITION_MAX_DAYS=0
COLLECTOR_LOG_LEVEL=INFO
MAIRUI_LICENCE=
# Opt-in rights-issue terms from public Eastmoney/Sina pages. Internal research
# only: the sites grant no redistribution rights. Default off.
COLLECTOR_PUBLIC_RIGHTS_FEED=false
# For remote clients set a reachable bind address and put the service behind TLS.
COLLECTOR_BIND_ADDRESS=127.0.0.1
COLLECTOR_PORT=18100

# Optional Linux local host-network override: compose.collector.local.yaml.
# Do not use local loopback callback/database settings for remote deployments.
COLLECTOR_LOCAL_DB_PORT=15436
COLLECTOR_LOCAL_AUTHORIZER_URL=http://127.0.0.1:3122/internal/data/authorize

# Internal request credit safeguards, not an asserted vendor invoice limit.
COLLECTOR_MAIRUI_DAILY_CREDITS=10000
COLLECTOR_SCOPE_DAILY_CREDITS=2000
COLLECTOR_SOURCE_CONCURRENCY=4
COLLECTOR_SCOPE_CONCURRENCY=2
# Optional canonical scope UUID -> daily_credits/concurrency; unknown scopes use defaults.
COLLECTOR_SCOPE_LIMITS_JSON={}
COLLECTOR_PLAN_MAX_INSTRUMENTS=10000
COLLECTOR_PLAN_MAX_NEW_PARTS=20000
COLLECTOR_PLAN_CONFIRM_PARTS=100
COLLECTOR_PLAN_CONFIRM_CREDITS=500
# Overall socket-owner deadline (startup + all response chunks), 1..300 seconds.
COLLECTOR_REQUEST_TIMEOUT_SECONDS=90
# Trusted freshness outbox consumer; match the consuming application's setting.
COLLECTOR_FRESHNESS_CONSUMER_ID=qtrade-alerts
# Run explicitly enabled evidence watches; this does not download prices.
COLLECTOR_RUN_FRESHNESS=true
# Saved-check age for the read-only health view; 1–86400 seconds.
# This controls display validity, not supplier update rules or watch scheduling.
COLLECTOR_FRESHNESS_HEALTH_MAX_AGE_SECONDS=900
