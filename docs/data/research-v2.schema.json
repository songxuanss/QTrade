    "AdjustmentFactor": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 2,
          "default": 2,
          "title": "Schema Version",
          "type": "integer"
        },
        "scope_id": {
          "format": "uuid",
          "title": "Scope Id",
          "type": "string"
        },
        "source": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "instrument_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Instrument Id",
          "type": "string"
        },
        "collected_at": {
          "format": "date-time",
          "title": "Collected At",
          "type": "string"
        },
        "knowledge": {
          "$ref": "#/$defs/KnowledgeTime",
          "default": {
            "status": "unknown",
            "known_at": null,
            "evidence_reference": null
          }
        },
        "source_revision": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Revision"
        },
        "mapping_version": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Mapping Version",
          "type": "string"
        },
        "kind": {
          "const": "adjustment_factor",
          "default": "adjustment_factor",
          "title": "Kind",
          "type": "string"
        },
        "observation_date": {
          "format": "date",
          "title": "Observation Date",
          "type": "string"
        },
        "adjustment": {
          "enum": [
            "forward",
            "backward",
            "total_return"
          ],
          "title": "Adjustment",
          "type": "string"
        },
        "factor": {
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "title": "Factor",
          "type": "string"
        },
        "base_date": {
          "format": "date",
          "title": "Base Date",
          "type": "string"
        },
        "base_value": {
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "title": "Base Value",
          "type": "string"
        },
        "algorithm_version": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Algorithm Version",
          "type": "string"
        },
        "convention_evidence": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Convention Evidence",
          "type": "string"
        }
      },
      "required": [
        "scope_id",
        "source",
        "instrument_id",
        "collected_at",
        "mapping_version",
        "observation_date",
        "adjustment",
        "factor",
        "base_date",
        "base_value",
        "algorithm_version",
        "convention_evidence"
      ],
      "title": "AdjustmentFactor",
      "type": "object"
    },
